diff --git a/merkle-tree/src/hiding_mmcs.rs b/merkle-tree/src/hiding_mmcs.rs
index 0f01bbb..2172aa9 100644
--- a/merkle-tree/src/hiding_mmcs.rs
+++ b/merkle-tree/src/hiding_mmcs.rs
@@ -134,14 +134,20 @@ where
         &self,
         inputs: Vec<M>,
     ) -> (Self::Commitment, Self::ProverData<M>) {
-        let mut rng = self.rng.lock();
-        let salted_inputs = inputs
-            .into_iter()
-            .map(|mat| {
-                let salts = RowMajorMatrix::rand(&mut *rng, mat.height(), SALT_ELEMS);
-                HorizontalPair::new(mat, salts)
-            })
-            .collect();
+        // Draw all salts, then release the lock before the Merkle tree is built.
+        // The tree build runs in parallel. A rayon worker that holds this spin lock
+        // and waits for a sub-task can pick up another `commit` on the same instance.
+        // That task would spin forever on a lock its own thread holds.
+        let salted_inputs: Vec<_> = {
+            let mut rng = self.rng.lock();
+            inputs
+                .into_iter()
+                .map(|mat| {
+                    let salts = RowMajorMatrix::rand(&mut *rng, mat.height(), SALT_ELEMS);
+                    HorizontalPair::new(mat, salts)
+                })
+                .collect()
+        };
         self.inner.commit(salted_inputs)
     }
 
